# Local defaults use SQLite, no active checkout and no paid provider requests.
# Inject production secrets from your hosting secret manager. Never commit .env.
APP_ENV=development
SITE_URL=http://localhost:4173
ALLOWED_HOSTS=localhost,127.0.0.1
# Production: strong random secret, PostgreSQL and Redis are REQUIRED.
DJANGO_SECRET_KEY=
DATABASE_URL=
REDIS_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_STUDIO=
STRIPE_PRICE_TEAM=
PLAN_CREDITS_CREATOR=0
PLAN_CREDITS_STUDIO=0
PLAN_CREDITS_TEAM=0
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
GEMINI_API_KEY=
CARTESIA_API_KEY=
# Enable only models approved for your commercial use/resale arrangement.
# MusicGen is never allowed in this paid service.
COMMERCIAL_MODEL_IDS=gpt-4o-mini-tts
# Production proxy must strip client forwarding headers and set these itself.
# Never enable with an internet-exposed backend or an untrusted proxy.
TRUST_PROXY_TLS=0
TRUSTED_PROXY_IPS=
